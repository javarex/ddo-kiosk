{
  "name": "ddo-kiosk",
  "version": "1.3.7",
  "main": "src/main/index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:css": "npx postcss src/renderer/styles.css -o dist/bundle.css",
    "build:renderer": "node build-renderer.js",
    "build:all-node": "npm run build:renderer && node build.js && node build-print.js",
    "start": "npm run build:css && npm run build:renderer && electron .",
    "build": "npm run build:css && npm run build:print-css && npm run copy:assets && electron-builder",
    "build-setup": "npm run build:css && npm run build:print-css && npm run build:all-node && npm run build",
    "copy:assets": "npx cpy assets/**/* dist/assets",
    "build:print-css": "npx postcss src/renderer/print.css -o dist/print.css",
    "watch:css": "npx postcss src/renderer/styles.css -o dist/bundle.css --watch",
    "watch:print-css": "npx postcss src/renderer/print.css -o dist/print.css --watch"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.7",
    "autoprefixer": "^10.4.21",
    "cpy-cli": "^5.0.0",
    "electron": "^36.2.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.4",
    "postcss": "^8.4.38",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^3.3.5"
  },
  "dependencies": {
    "alpinejs": "^3.14.9",
    "qrcode": "^1.5.4"
  },
  "build": {
    "appId": "com.yourcompany.ddo-kioskv2",
    "productName": "DDO Kiosk V2",
    "files": [
      "dist/**/*",
      "src/**/*",
      "node_modules/**/*",
      "package.json",
      "assets/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    }
  }
}
